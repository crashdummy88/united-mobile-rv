# frame-src allows the Square booking site so book. can embed it.
# Shop and forum pages do not include that frame. frame-ancestors stays 'none'.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://*.square.site https://*.squareup.com https://*.squarecdn.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# X-Robots-Tag is now set by functions/_middleware.js instead of here —
# Cloudflare Pages merges/duplicates X-Robots-Tag across matching _headers
# blocks rather than letting a more specific path override it, which broke
# the /forum/ and /forum-live/ index exception (both noindex and index sent
# at once, and Google treats duplicate X-Robots-Tag headers as a union where
# noindex always wins). The middleware sets exactly one clean value per path.

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=86400, must-revalidate

/js/*
  Cache-Control: public, max-age=86400, must-revalidate
